      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (method, handler) (rate(http_requests_total{job=\"$job\", handler!~\"/metrics|/health\"}[$__rate_interval]))",
          "legendFormat": "{{method}} {{handler}}",
          "editorMode": "code",
          "range": true,
          "instant": false
